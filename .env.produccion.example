# Copiar a .env.produccion (NO subir a git) y completar. Guía: docs/despliegue.md
# Dominio con el que se abre la app (debe apuntar a este servidor). Se usa para el certificado HTTPS.
DOMINIO=cmms.nutrialimentos.com.co
# Zona horaria de la planta
APP_TZ=America/Bogota

# Claves: genere cada una con  openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=
# Clave con que se cifran los respaldos. Guárdela también FUERA del servidor: sin ella no se pueden restaurar.
BACKUP_PASSPHRASE=

# Respaldos
RESPALDO_HORA=02:30
RETENCION_DIAS=30
# Carpeta del servidor donde quedan los respaldos (idealmente un disco o NAS distinto al de la base)
RESPALDOS_EN_SERVIDOR=./respaldos

# Sesión y archivos
JWT_EXPIRES_IN=8h
MAX_UPLOAD_MB=20

# Avisos al celular (opcional): npm run push:claves en backend, o
#   docker compose -f docker-compose.prod.yml run --rm app npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mantenimiento@nutrialimentos.com.co
