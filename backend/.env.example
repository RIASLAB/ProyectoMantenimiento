# Copiar a .env y ajustar
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/cmms
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
JWT_EXPIRES_IN=8h
UPLOADS_DIR=./uploads
# Tamaño máximo de documentos adjuntos (MB)
MAX_UPLOAD_MB=20
# Origen permitido para el frontend (CORS)
CORS_ORIGIN=http://localhost:5173
# Base de datos para pruebas automáticas (se borra en cada ejecución)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/cmms_test
# Zona horaria de la planta (indicadores y avisos de preventivos)
APP_TZ=America/Bogota
# Avisos al celular (Web Push). Sin estas claves solo funciona la bandeja dentro de la app.
# Generarlas una vez con: npm run push:claves   y pegar aquí las dos claves.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del responsable (mailto: o https:), lo exige el estándar Web Push
VAPID_SUBJECT=mailto:mantenimiento@nutrialimentos.com.co
